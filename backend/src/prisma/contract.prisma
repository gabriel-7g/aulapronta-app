// use prisma-8

model Usuario {
  id             Uuid             @id @default(uuid())
  nome           String
  email          String           @unique
  senha          String
  tipo           String           @default("usuario")
  criadoEm       TimestamptzString @default(now())
  atualizadoEm   temporal.updatedAtString()

  planejamentos  Planejamento[]

  @@map("usuarios")
}

model Planejamento {
  id              Uuid              @id @default(uuid())
  usuarioId       Uuid

  nivelEnsino     String?
  materia         String
  materiaId       String?
  turma           String
  duracao         String
  tema            String
  observacoes     String?

  titulo          String
  objetivo        String
  introducao      String
  desenvolvimento String
  atividade       String
  recursos        String
  avaliacao       String

  criadoEm        TimestamptzString @default(now())
  atualizadoEm    temporal.updatedAtString()

  usuario Usuario @relation(
    fields: [usuarioId],
    references: [id],
    onDelete: Cascade
  )

  @@index([usuarioId])
  @@map("planejamentos")
}